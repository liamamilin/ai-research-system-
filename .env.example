# Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit it.

# Web UI JWT signing secret (production: long random string,
# generate with: openssl rand -hex 32)
AI_RESEARCH_SECRET_KEY="change-me-to-a-long-random-string"

# LLM API key (referenced by ai.api_key_env in system.yaml).
# Leave empty when using a local endpoint such as Ollama.
LLM_API_KEY=""

# Web search API key (referenced by search.api_key_env in system.yaml).
# Parallel Search API: https://platform.parallel.ai
PARALLEL_API_KEY="your-parallel-api-key"

# Optional: API key for the report cleanup pass (extraction.enabled=true)
EXTRACTION_API_KEY=""

# Optional: SMTP password for email notifications
# (referenced by notifications.email.smtp_password_env in system.yaml)
SMTP_PASSWORD=""

# Optional: notification webhooks (referenced by
# notifications.<channel>.webhook_url_env in system.yaml)
WECOM_WEBHOOK_URL=""
FEISHU_WEBHOOK_URL=""
FEISHU_BOT_SECRET=""
NOTIFY_WEBHOOK_URL=""
