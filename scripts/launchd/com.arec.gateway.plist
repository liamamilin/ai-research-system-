<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arec.gateway</string>

  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@SCRIPT_DIR@/gateway.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@REPO@</string>

  <!-- KeepAlive is the whole point: this process must outlive the app, the
       30-minute idle shutdown, and a crash, so a bookmarked URL always
       answers. RunAtLoad brings it back after a reboot or login. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>@LOG_DIR@/gateway.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/gateway.err.log</string>
</dict>
</plist>
